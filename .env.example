# =============================================================================
# Autonomous Trader — environment template.  Copy to .env and fill values.
#   cp .env.example .env
# PLACEHOLDERS ONLY — never commit real secrets. .env is gitignored.
# All vars are injected into the api/scheduler containers via env_file (.env).
# The backend reads everything straight from the process environment; there is
# no pydantic-settings / python-dotenv layer.
# =============================================================================

# --- Database (db container) -------------------------------------------------
# These configure the TimescaleDB container itself.
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=autonomous_trader

# --- Database (app connection) ----------------------------------------------
# DATABASE_URL is what the api + scheduler + alembic actually use. It MUST point
# at the same database as the POSTGRES_* values above. Host is the compose
# service name `db`. The app, the scheduler job-store rewrite, and Alembic all
# read this one var:
#   - app + Alembic use it AS-IS  -> must be the async driver (+asyncpg)
#   - the scheduler rewrites +asyncpg -> +psycopg for its sync job store
# So always use +asyncpg here:
DATABASE_URL=postgresql+asyncpg://trader:change_me_strong_password@db:5432/autonomous_trader
# Optional explicit override for the APScheduler job store (sync driver). Leave
# unset to let the scheduler derive it from DATABASE_URL automatically.
# SCHEDULER_DB_URL=postgresql+psycopg://trader:change_me_strong_password@db:5432/autonomous_trader

# --- Host ports --------------------------------------------------------------
# Host-side published ports. compose interpolates these in the `ports:` blocks, so
# deploy.sh must pass --env-file ../.env for them to take effect. In DEV the Vite
# frontend owns FRONTEND_PORT (the public subdomain) and FastAPI moves to API_PORT;
# they MUST differ or the two containers collide on the same host port.
DB_PORT=8031
API_PORT=8033
FRONTEND_PORT=8030
SCHEDULER_PORT=8032

# --- Application -------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated extra CORS origins. Empty = same-origin only (the API serves
# the built dashboard itself, so leave empty in production).
CORS_ALLOW_ORIGINS=
# Path to the strategy config inside the container (image ships it at this path).
STRATEGY_CONFIG_PATH=/app/config/strategy.yaml

# --- Broker / trading seam ---------------------------------------------------
# THE sacred swap: paper -> a real adapter requires only this var (no code edits).
# Phase 1 ships `paper` (DB-backed sim) and `mock_real` (in-memory swap-test double).
BROKER_ADAPTER=paper
# Starting virtual cash for the paper portfolio (EUR).
STARTING_CASH=500
# Simulated fill slippage applied to every order (fraction, 0.001 = 0.1%).
SLIPPAGE_PCT=0.001

# --- Risk parameters (RiskManager) -------------------------------------------
# Max fraction of portfolio value per single position.
MAX_POSITION_PCT=0.05
# Hard cap on concurrent open positions.
MAX_OPEN_POSITIONS=10
# Dry-powder reserve: never deploy below this fraction of value as cash.
MIN_CASH_PCT=0.20
# Allow fractional shares (true) so a small budget can still take a position in a
# high-priced symbol. Set false to force whole-share orders.
ALLOW_FRACTIONAL=true
# Skip a position whose target allocation falls below this many EUR (dust floor).
MIN_POSITION_EUR=1

# --- Intraday protective sell (trailing stop) --------------------------------
# A guard job that runs every N minutes during market hours, checks live prices for
# held positions and sells any that retraced past the trailing stop from their peak
# (cuts losses AND locks in gains). Independent of the daily 08:00 pipeline.
PROTECTIVE_SELL_ENABLED=true
# Retrace from the high-water mark that triggers a sell (0.08 = 8%). Used as the
# stop distance when ATR isn't available, and as a fallback.
TRAILING_STOP_PCT=0.08
# How often to check live prices during market hours (minutes).
PROTECTIVE_SELL_INTERVAL_MIN=15
# Volatility-adaptive stop: distance = ATR(14) * this multiple (preferred over the flat
# %, wider for choppy names). Set 0 to always use TRAILING_STOP_PCT.
STOP_ATR_MULTIPLE=2.5
# Market-stress regime (live VIX): tighten the stop under stress, hold in panic.
STOP_REGIME_ENABLED=true
# At/above this VIX, tighten the stop (multiply its distance by STOP_TIGHTEN_FACTOR).
VIX_TIGHTEN_ABOVE=30
STOP_TIGHTEN_FACTOR=0.6
# At/above this VIX it's panic: suspend protective selling (don't sell the capitulation —
# extreme VIX is historically near the bottom). Set VIX_PANIC_HOLD=false to always protect.
VIX_PANIC_ABOVE=40
VIX_PANIC_HOLD=true

# --- Analysis ----------------------------------------------------------------
# Annual risk-free rate used in Sharpe/performance metrics.
RISK_FREE_RATE=0.045
# Reject bars whose move exceeds this fraction vs prior (0.50 = 50%).
PRICE_ANOMALY_PCT=0.50
# Max age (days) before stored market data is considered stale.
DATA_STALE_MAX_AGE_DAYS=4
# NOTE: strategy weights/thresholds live in config/strategy.yaml, not here.
# They can be overridden per-key with STRATEGY__<SECTION>__<KEY> env vars, e.g.
# STRATEGY__RANKER__MIN_SCORE_TO_ACT=0.6  (double underscore nests sections).

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_TIMEZONE=UTC
# Grace window (seconds) for missed jobs after a reboot; past this, jobs skip.
MISFIRE_GRACE_TIME=3600

# --- Data providers ----------------------------------------------------------
# Primary OHLCV provider. yfinance needs no key; twelve_data is the fallback.
MARKET_DATA_PROVIDER=yfinance
# Exchange calendar for trading-day / market-closed detection.
MARKET_CALENDAR=NYSE
# yfinance hardening (Yahoo rate-limits flagged IPs even with a browser UA).
# Retries per symbol on 429/5xx with exponential backoff; pacing between symbols.
YFINANCE_MAX_RETRIES=3
YFINANCE_THROTTLE_MS=250
# Twelve Data fallback (free tier). Leave blank to use yfinance only; the
# fallback simply won't engage without a key.
TWELVE_DATA_API_KEY=
# Batch size for Twelve Data requests (comma-batched symbols per call).
TWELVE_DATA_BATCH=8
# Free-tier credit ceiling: /time_series costs 1 credit PER SYMBOL and the cap is
# ~8 credits/min. Requests are paced to stay under this. Set 0 to disable pacing.
TWELVE_DATA_CREDITS_PER_MIN=8

# --- Watchlist seed ---------------------------------------------------------
# Loaded by init-db.sh ONLY when the watchlist table is empty (removed symbols
# are not resurrected). Symbols stay editable via the API. Default is a committed
# diversified basket so the system trades out of the box; set empty to disable.
WATCHLIST_SEED_FILE=config/watchlist.seed.csv
